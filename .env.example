# =============================================================================
# Copy this file to .env.local and fill in your values.
#
# All keys are unprefixed (no NEXT_PUBLIC_*).
# - Server-side: Next.js loads these from .env.local automatically via process.env
# - Client-side: `pnpm dev` runs `predev` which writes public/env-config.js
#                with window.__ENV__, so the browser reads from there.
#
# In production, the same keys are injected by Infisical into the pod and
# written to public/env-config.js at container startup by docker-entrypoint.sh.
# =============================================================================

# --- Public (exposed to the browser via window.__ENV__) ----------------------

CIVITAS_API_URL=""
MAPBOX_ACCESS_TOKEN=""
ENABLE_CHAMADOS="false"
ENABLE_IMPERSONATION="false"
APP_URL=""

# --- Private (server-side only) ----------------------------------------------

# Required — generate with: openssl rand -hex 64
AUTH_SESSION_SECRET=""

# Required — session timeout values (in seconds)
AUTH_SHORT_IDLE_TIMEOUT_SECONDS="3600"      # 1 hour
AUTH_SHORT_ABSOLUTE_TIMEOUT_SECONDS="3600"  # 1 hour
AUTH_LONG_IDLE_TIMEOUT_SECONDS="86400"      # 24 hours
AUTH_LONG_ABSOLUTE_TIMEOUT_SECONDS="604800" # 7 days

# Optional — defaults shown
AUTH_COOKIE_SECURE="false"
AUTH_COOKIE_SAMESITE="lax"
AUTH_TOKEN_PATH="/auth/token"
AUTH_ACCESS_TOKEN_REFRESH_LEEWAY_SECONDS="60"

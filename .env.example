# =============================================================================
# LOCAL DEVELOPMENT — copy this file to .env.local and fill in your values.
# =============================================================================
#
# PUBLIC ENV VARS (exposed to the browser)
# ----------------------------------------
# In local development, Next.js reads NEXT_PUBLIC_* vars from .env.local and
# statically replaces them in the client bundle at dev-server startup.
#
# In production (new infra / chore/migrate-infra), these are NOT build args.
# Instead, they are injected into the pod by Infisical using the unprefixed key
# names (CIVITAS_API_URL, MAPBOX_ACCESS_TOKEN, etc.) and exposed to the browser
# at container startup via window.__ENV__ (see scripts/docker-entrypoint.sh).
#
# To keep local dev working, define BOTH the NEXT_PUBLIC_ variant (for the
# client bundle) AND the unprefixed variant (for server-side API routes).

# Client-side (Next.js static replacement in dev):
NEXT_PUBLIC_CIVITAS_API_URL=""
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=""
NEXT_PUBLIC_ENABLE_CHAMADOS="false"
NEXT_PUBLIC_ENABLE_IMPERSONATION="false"
NEXT_PUBLIC_APP_URL=""

# Server-side (process.env — used by API routes and server components in dev
# AND in production, where Infisical injects them without the NEXT_PUBLIC_ prefix):
CIVITAS_API_URL=""
MAPBOX_ACCESS_TOKEN=""
ENABLE_CHAMADOS="false"
ENABLE_IMPERSONATION="false"
APP_URL=""

# =============================================================================
# PRIVATE ENV VARS (server-side only — injected by Infisical in production)
# =============================================================================

# Required — must be a long random secret (≥64 chars), e.g.: openssl rand -hex 64
AUTH_SESSION_SECRET=""

# Required — session timeout values (in seconds)
AUTH_SHORT_IDLE_TIMEOUT_SECONDS="3600"      # 1 hour
AUTH_SHORT_ABSOLUTE_TIMEOUT_SECONDS="3600"  # 1 hour
AUTH_LONG_IDLE_TIMEOUT_SECONDS="86400"      # 24 hours
AUTH_LONG_ABSOLUTE_TIMEOUT_SECONDS="604800" # 7 days

# Optional — defaults shown
AUTH_COOKIE_SECURE="false"         # set to "true" in production
AUTH_COOKIE_SAMESITE="lax"         # lax | strict | none
AUTH_TOKEN_PATH="/auth/token"
AUTH_ACCESS_TOKEN_REFRESH_LEEWAY_SECONDS="60"
